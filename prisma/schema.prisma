// Target: PostgreSQL on Neon

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Prisma 7: connection URLs live in prisma.config.ts (Migrate) and the
  // PrismaClient adapter (runtime), not here.
  extensions = [citext]
}

// ─────────────────────────────── Auth ───────────────────────────────

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Case-insensitive unique via citext. App still trims input.
  email        String   @unique @db.Citext
  /// argon2id (or bcrypt) hash — never the plaintext password.
  passwordHash String   @map("password_hash")
  /// Set when the user finishes or skips onboarding (F5). Null = not yet shown.
  onboardedAt  DateTime? @map("onboarded_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions  Session[]
  lookups   StockLookup[]
  favorites Favorite[]

  @@map("users")
}

/// A stock a user saved to their dashboard (F1–F4). One row per user+symbol.
model Favorite {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Normalized symbol (trim + uppercase), same as lookups/quotes.
  symbol    String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // F3: saving the same symbol twice leaves one entry.
  @@unique([userId, symbol])
  // Dashboard read: a user's favorites, newest first.
  @@index([userId, createdAt(sort: Desc)])
  @@map("favorites")
}

/// Server-side session. The cookie holds a random token; the DB stores only
/// SHA-256(token) as the primary key, so a DB leak can't be replayed as cookies.
/// Logout = delete the row.
model Session {
  id        String   @id @db.VarChar(64) // hex SHA-256 of the session token
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  userAgent String?  @map("user_agent") @db.VarChar(512)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt]) // expired-session sweeps
  @@map("sessions")
}

// ───────────────────────────── Stock data ─────────────────────────────

enum QuoteStatus {
  FOUND     // Finnhub returned a real quote (t > 0)
  NOT_FOUND // Finnhub returned HTTP 200 with a zeroed body (t == 0)

  @@map("quote_status")
}

/// One row per *upstream* Finnhub /quote call. Append-only.
/// Doubles as the quote cache (positive and negative): a lookup reuses the
/// newest row for a symbol if fetched_at is within the app's TTL.
model Quote {
  id            String      @id @default(uuid(7)) @db.Uuid
  /// Normalized: trimmed + uppercased before lookup and before storage.
  symbol        String      @db.VarChar(20)
  status        QuoteStatus
  // Prices are null when status = NOT_FOUND (enforced by CHECK in migration SQL).
  openPrice     Decimal?    @map("open_price") @db.Decimal(18, 6)     // o
  currentPrice  Decimal?    @map("current_price") @db.Decimal(18, 6)  // c
  highPrice     Decimal?    @map("high_price") @db.Decimal(18, 6)     // h
  lowPrice      Decimal?    @map("low_price") @db.Decimal(18, 6)      // l
  previousClose Decimal?    @map("previous_close") @db.Decimal(18, 6) // pc
  change        Decimal?    @db.Decimal(18, 6)                        // d
  changePercent Decimal?    @map("change_percent") @db.Decimal(12, 6) // dp
  /// Finnhub `t` converted from UNIX seconds. Null when t == 0.
  quotedAt      DateTime?   @map("quoted_at") @db.Timestamptz(6)
  /// When we called Finnhub. Drives cache freshness.
  fetchedAt     DateTime    @default(now()) @map("fetched_at") @db.Timestamptz(6)

  lookups StockLookup[]

  // Cache read: newest quote for a symbol.
  @@index([symbol, fetchedAt(sort: Desc)])
  @@map("quotes")
}

/// One row per user search — the user's history. Append-only.
/// Outcome is derived: quote.status if quoteId is set, otherwise ERROR
/// (errorCode set). Exactly one of quoteId / errorCode is non-null (CHECK).
model StockLookup {
  id              String   @id @default(uuid(7)) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  /// Normalized symbol the user searched (kept even when the call errored).
  symbol          String   @db.VarChar(20)
  quoteId         String?  @map("quote_id") @db.Uuid
  /// True if served from an existing Quote row rather than a fresh API call.
  servedFromCache Boolean  @default(false) @map("served_from_cache")
  /// e.g. RATE_LIMITED, UPSTREAM_ERROR, TIMEOUT. Null on success / not-found.
  errorCode       String?  @map("error_code") @db.VarChar(32)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Restrict: pruning the cache must never erase a user's history.
  quote Quote? @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)]) // "my recent searches"
  @@index([quoteId])
  @@map("stock_lookups")
}
